{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dist/**"
    ],
    "rewrites": [
      {
        "source": "/landing-page",
        "destination": "/landing-page/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
